// Prisma schema — Lumis
// https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------- Enums ----------

enum Role {
  USER
  ADMIN
}

enum ThemePreference {
  LIGHT
  DARK
  SYSTEM
}

enum FontPreference {
  LORA // serif clásica
  PLAYFAIR_DISPLAY // serif decorativa/editorial
  INTER // sans-serif moderna
  CAVEAT // manuscrita/cálida
}

enum ReaderTheme {
  LIGHT
  DARK
  SEPIA
}

enum BookFormat {
  PDF
  EPUB
  MOBI
  CBR
  CBZ
  TXT
}

enum ShelfArrangement {
  SPINE // lomo
  COVER // portada de frente
}

enum RecommendLevel {
  YES
  MAYBE
  NO
}

enum ReadingStatus {
  TBR
  READING
  PAUSED
  FINISHED
  REREAD
  ABANDONED
}

// ---------- Models ----------

model User {
  id              String          @id @default(cuid())
  email           String          @unique
  passwordHash    String          @map("password_hash")
  displayName     String          @map("display_name")
  // Private-bucket storage path (like Book.coverImageKey) -- a signed URL is
  // generated on read, never exposed directly.
  avatarImageKey  String?         @map("avatar_image_key")
  bio             String?
  location        String?
  favoriteQuote   String?         @map("favorite_quote")
  // Annual reading goal (books), user-set — null means no goal configured.
  readingGoal     Int?            @map("reading_goal")
  // ISO 3166-1 alpha-2 (e.g. "AR") — for display/future language selection,
  // decoupled from timezone (a country can span several).
  country         String?
  // IANA timezone name (e.g. "America/Argentina/Buenos_Aires"), user-set or
  // autodetected client-side — determines the local-day boundary used for
  // the reading streak and "night reading" detection. Defaults to UTC when
  // unset so those features still work, just less precisely, before the
  // user (or client autodetection) sets a real one.
  timezone        String?
  role            Role            @default(USER)
  themePreference ThemePreference @default(SYSTEM) @map("theme_preference")
  fontPreference  FontPreference  @default(LORA) @map("font_preference")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  refreshTokens       RefreshToken[]
  books               Book[]
  shelves             Shelf[]
  reviews             Review[]
  readingProgress     ReadingProgress[]
  readingActivityLogs ReadingActivityLog[]
  highlights          Highlight[]
  notes               Note[]
  strokes             Stroke[]
  spotifyAccount      SpotifyAccount?

  @@map("users")
}

// One row per (user, local calendar day) with any reading-progress activity
// — the history ReadingProgress alone can't provide (it's one mutable row
// per book, not an event log), needed to compute a real day-streak and
// detect night reading. Written from ReadingProgressService.upsert.
model ReadingActivityLog {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // The user's local calendar day, stored as that day's UTC midnight.
  date      DateTime
  isNight   Boolean  @default(false) @map("is_night")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, date])
  @@index([userId])
  @@map("reading_activity_log")
}

// Hashed refresh tokens, so rotation/revocation doesn't depend on trusting the JWT alone.
model RefreshToken {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("refresh_tokens")
}

model Book {
  id                   String     @id @default(cuid())
  ownerId              String     @map("owner_id")
  owner                User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  title                String
  author               String?
  format               BookFormat
  originalFileKey      String     @map("original_file_key") // path within the private Supabase Storage bucket
  coverImageKey        String?    @map("cover_image_key") // path within the private bucket; signed URLs are generated on read
  normalizedContentUrl String?    @map("normalized_content_url") // paginated HTML/image layer used by the reader
  pageCount            Int?       @map("page_count")
  fileSizeBytes        Int?       @map("file_size_bytes")
  metadata             Json? // format-specific extras: isbn, publisher, language, etc.
  sortOrder            Int        @default(0) @map("sort_order")
  createdAt            DateTime   @default(now()) @map("created_at")
  updatedAt            DateTime   @updatedAt @map("updated_at")

  shelves         BookShelf[]
  reviews         Review[]
  readingProgress ReadingProgress[]
  highlights      Highlight[]
  notes           Note[]
  strokes         Stroke[]

  @@index([ownerId])
  @@map("books")
}

model Shelf {
  id                 String           @id @default(cuid())
  ownerId            String           @map("owner_id")
  owner              User             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name               String
  genre              String?
  arrangement        ShelfArrangement @default(SPINE)
  shelfColor         String?          @map("shelf_color") // the bookcase/furniture color
  shelfFrame         String?          @map("shelf_frame") // selected wood-tone frame image key
  backgroundColor    String?          @map("background_color") // the wall/backdrop behind it
  backgroundImageUrl String?          @map("background_image_url")
  canvasWidth        Int?             @map("canvas_width") // user-resized canvas box, in px (design space is 1000x600)
  canvasHeight       Int?             @map("canvas_height")
  decorations        Json             @default("[]") // [{ type: "plant" | "light" | ..., variant, x, y, rotation }]
  spotifyPlaylistId  String?          @map("spotify_playlist_id")
  spotifyPlaylistUrl String?          @map("spotify_playlist_url")
  sortOrder          Int              @default(0) @map("sort_order")
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")

  books BookShelf[]

  @@index([ownerId])
  @@map("shelves")
}

// Many-to-many join between Book and Shelf, carrying per-shelf layout position.
model BookShelf {
  id       String   @id @default(cuid())
  bookId   String   @map("book_id")
  book     Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  shelfId  String   @map("shelf_id")
  shelf    Shelf    @relation(fields: [shelfId], references: [id], onDelete: Cascade)
  position Json? // { x, y, rotation? } — freeform placement on the shelf's canvas
  addedAt  DateTime @default(now()) @map("added_at")

  @@unique([bookId, shelfId])
  @@index([shelfId])
  @@index([bookId])
  @@map("book_shelves")
}

// One review/rating record per user+book. "Reread" just updates status + dates in place (MVP scope).
model Review {
  id                     String          @id @default(cuid())
  userId                 String          @map("user_id")
  user                   User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookId                 String          @map("book_id")
  book                   Book            @relation(fields: [bookId], references: [id], onDelete: Cascade)
  status                 ReadingStatus   @default(TBR)
  rating                 Int? // 1-5 stars
  spicyRating            Int?            @map("spicy_rating") // 1-5 chiles
  romanceRating          Int?            @map("romance_rating") // 1-5 corazones
  plotRating             Int?            @map("plot_rating") // 1-5 estrellas
  sadnessRating          Int?            @map("sadness_rating") // 1-5 gotas
  humorRating            Int?            @map("humor_rating") // 1-5 caritas
  mysteryRating          Int?            @map("mystery_rating") // 1-5 bolas de cristal
  genre                  String?
  favoriteCharacter      String?         @map("favorite_character")
  leastFavoriteCharacter String?         @map("least_favorite_character")
  favoriteQuote          String?         @map("favorite_quote")
  cried                  Boolean?
  recommend              RecommendLevel?
  bookNumberOfYear       Int?            @map("book_number_of_year")
  mood                   String?
  notes                  String?
  bodyRichText           Json?           @map("body_rich_text")
  startedAt              DateTime?       @map("started_at")
  finishedAt             DateTime?       @map("finished_at")
  createdAt              DateTime        @default(now()) @map("created_at")
  updatedAt              DateTime        @updatedAt @map("updated_at")

  @@unique([userId, bookId])
  @@index([bookId])
  @@map("reviews")
}

// The exact resume position ("bookmark"), separate from Review's opinion/status data.
model ReadingProgress {
  id              String      @id @default(cuid())
  userId          String      @map("user_id")
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookId          String      @map("book_id")
  book            Book        @relation(fields: [bookId], references: [id], onDelete: Cascade)
  currentPage     Int         @default(0) @map("current_page")
  currentLocator  Json?       @map("current_locator") // fine-grained position within the page (e.g. EPUB CFI-like offset)
  progressPercent Float       @default(0) @map("progress_percent")
  readerTheme     ReaderTheme @default(LIGHT) @map("reader_theme")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  @@unique([userId, bookId])
  @@map("reading_progress")
}

model Highlight {
  id           String   @id @default(cuid())
  userId       String   @map("user_id")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookId       String   @map("book_id")
  book         Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  // Free-form color, 6- or 8-digit hex (#RRGGBB[AA]) — a full spectrum with
  // transparency, not a fixed palette.
  color        String   @default("#F5D76EAA")
  // Highlighter-pen stroke thickness: "thin" | "normal" | "thick".
  size         String   @default("normal")
  pageIndex    Int      @map("page_index")
  startOffset  Int      @map("start_offset")
  endOffset    Int      @map("end_offset")
  selectedText String   @map("selected_text")
  // EPUB-only: authoritative anchor for reflowable content (pageIndex/startOffset/
  // endOffset are non-authoritative placeholders there — see epub-reader.tsx).
  cfi          String?
  createdAt    DateTime @default(now()) @map("created_at")

  notes Note[]

  @@index([bookId, userId])
  @@map("highlights")
}

// A post-it anchored to a page position; can optionally hang off a highlight.
model Note {
  id          String     @id @default(cuid())
  userId      String     @map("user_id")
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookId      String     @map("book_id")
  book        Book       @relation(fields: [bookId], references: [id], onDelete: Cascade)
  highlightId String?    @map("highlight_id")
  highlight   Highlight? @relation(fields: [highlightId], references: [id], onDelete: SetNull)
  pageIndex   Int        @map("page_index")
  offset      Int
  body        String
  colorTag    String?    @map("color_tag") // post-it variant
  // EPUB-only: authoritative anchor for reflowable content — see Highlight.cfi.
  cfi         String?
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  @@index([bookId, userId])
  @@map("notes")
}

// A freehand brush stroke drawn directly on a page — pixel-geometry
// annotation, independent of Highlight's text-offset anchoring (used by the
// drawing/brush tool, which paints anywhere rather than only over text).
model Stroke {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookId    String   @map("book_id")
  book      Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  pageIndex Int      @map("page_index")
  // [[x, y], ...] normalized 0-1 against the page's own width/height, so the
  // stroke re-scales correctly at any zoom level or container size.
  points    Json
  // 6- or 8-digit hex (#RRGGBB[AA]).
  color     String
  brush     String
  size      Float
  createdAt DateTime @default(now()) @map("created_at")

  @@index([bookId, userId])
  @@map("strokes")
}

model SpotifyAccount {
  id            String   @id @default(cuid())
  userId        String   @unique @map("user_id")
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  spotifyUserId String   @map("spotify_user_id")
  accessToken   String   @map("access_token")
  refreshToken  String   @map("refresh_token")
  expiresAt     DateTime @map("expires_at")
  scope         String
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("spotify_accounts")
}
