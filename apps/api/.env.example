# Database (Supabase Postgres connection string — use the "Transaction" pooler URI for DATABASE_URL
# and the "Session" direct URI for DIRECT_URL, both from Supabase > Project Settings > Database)
DATABASE_URL="postgresql://postgres:password@localhost:5432/lumis?schema=public"
DIRECT_URL="postgresql://postgres:password@localhost:5432/lumis?schema=public"

# Auth
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_REFRESH_EXPIRES_IN="30d"

# Supabase Storage (book files + cover images)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="change-me"
SUPABASE_STORAGE_BUCKET="books"
MAX_UPLOAD_SIZE_MB=100

# Spotify OAuth
SPOTIFY_CLIENT_ID="change-me"
SPOTIFY_CLIENT_SECRET="change-me"
SPOTIFY_REDIRECT_URI="http://localhost:3000/api/spotify/callback"

# App
PORT=4000
CORS_ORIGIN="http://localhost:3000"
